<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="hotel_manag_mobile.AccountPage">
    <VerticalStackLayout Padding="20" Spacing="15">
        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Start" Spacing="10" Padding="10">
            <Button Text="Rooms"
                BackgroundColor="Purple"
                TextColor="White"
                Clicked="OnRoomsClicked" />
            <Button Text="Facilities"
                    BackgroundColor="Purple"
                    TextColor="White"
                    Clicked="OnFacilitiesClicked" />
            <Button Text="Reservations" 
                BackgroundColor="Purple"
                TextColor="White"
                Clicked="OnReservationsClicked" />
            <Button Text="Feedback"
                BackgroundColor="Purple"
                TextColor="White"
                Clicked="OnFeedbackClicked" />
    </HorizontalStackLayout>
    
        

            <Label x:Name="NavigationLabel" FontSize="20" HorizontalOptions="Center" />

            <Entry x:Name="NameEntry" Placeholder="Enter Name" />
            <Entry x:Name="EmailEntry" Placeholder="Enter Email" />
        <Entry x:Name="PasswordEntry" Placeholder="Enter Password" IsPassword="True" IsEnabled="True" />

            <Button Text="Save Changes" Clicked="OnSaveChangesClicked" BackgroundColor="Green" TextColor="White" />
            <Button Text="Delete Account" Clicked="OnDeleteAccountClicked" BackgroundColor="Red" TextColor="White" />
        </VerticalStackLayout>
</ContentPage>

    